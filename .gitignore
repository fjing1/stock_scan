# Scan outputs (regenerate locally; don't commit)
results/

# Large regenerable backtest caches (#24 swing study; panel_full.pkl is 253MB > GitHub limit)
Stock_OneClick/reports/exit_cache/

# Regenerable intraday bar cache written by intraday_store.py (23MB and growing)
Stock_OneClick/bars/

# Regenerable price panels for the research engines (6-20MB each; rebuild with the
# owning script's --refresh flag, e.g. gold_system.py --refresh)
# _rsi_obv_len_panel.pkl is 108MB — over GitHub's 100MB hard limit, never commit it.
Stock_OneClick/backend/_gold_panel.pkl
Stock_OneClick/backend/_aapl_panel.pkl
Stock_OneClick/backend/_ntr_panel.pkl
Stock_OneClick/backend/_ew_panel.pkl
Stock_OneClick/backend/_btc_panel.pkl
Stock_OneClick/backend/_btc_panel_4h.pkl
Stock_OneClick/backend/_nvda_panel.pkl
Stock_OneClick/backend/_vix_panel.pkl
Stock_OneClick/backend/_move_panel.pkl
Stock_OneClick/backend/_rsi_obv_len_panel.pkl

# Fitted model artifact for the MOVE study (18MB; rebuild with _move_validate.py)
Stock_OneClick/backend/_move_model.pkl

# Research-sweep intermediates (the conclusions live in reports/*.md; these are
# the raw per-symbol scratch output and can be regenerated by research_scan.py /
# research_forward.py)
Stock_OneClick/reports/research_scan_*.csv
Stock_OneClick/reports/research_scan_*_fail.txt
Stock_OneClick/reports/research_smoke.csv
Stock_OneClick/reports/research_smoke_fail.txt
Stock_OneClick/reports/research_per_symbol.csv
Stock_OneClick/reports/research_forward/
Stock_OneClick/reports/us_all_tickers.txt
Stock_OneClick/reports/us_mcap_top.csv

